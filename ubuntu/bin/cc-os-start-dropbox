#!/bin/bash
bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# The Dropbox daemon never opens a browser on its own -- it only prints a one-time
# sign-in link -- so on a machine that isn't linked yet, open that link for the user.
# `dropbox start -i` (from nautilus-dropbox) also downloads the daemon the first time.
command -v dropbox >/dev/null 2>&1 || exit 0
state="${XDG_STATE_HOME:-$HOME/.local/state}/cc-os"; mkdir -p "$state"
log="$state/dropbox.log"
pgrep -x dropbox >/dev/null && exit 0

(setsid dropbox start -i >"$log" 2>&1 </dev/null &)
for _ in $(seq 1 30); do
  sleep 2
  url=$(grep -o 'https://www.dropbox.com/cli_link_nonce?nonce=[0-9a-f]*' "$log" | tail -1)
  if [[ -n $url ]]; then
    setsid xdg-open "$url" >/dev/null 2>&1 </dev/null &
    # Claude opens wide right after this and covers the browser, so say where the
    # sign-in page went.
    notify-send -u critical "Sign in to Dropbox" \
      "The sign-in page is open in your browser. Claude fills the screen: press Super+S to hide it." || true
    break
  fi
  [[ -n $("$bin/cc-os-dropbox-status") ]] && break
done
exit 0
