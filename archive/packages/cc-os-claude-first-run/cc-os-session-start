#!/bin/bash
# Every graphical login: apply personal config, trim the app list, open Claude
# Desktop as the main interface, and finish any first-run setup that is still
# pending.
/usr/lib/cc-os/cc-os-apply-user-config
setsid /usr/lib/cc-os/cc-os-console-watch >/dev/null 2>&1 </dev/null &
setsid /usr/lib/cc-os/cc-os-trim-apps >/dev/null 2>&1 </dev/null &
if ! pacman -Q claude-desktop >/dev/null 2>&1; then
  setsid omarchy-launch-floating-terminal-with-presentation /usr/lib/cc-os/cc-os-install-apps &
else
  /usr/lib/cc-os/cc-os-claude-toggle --show &
  pacman -Q dropbox >/dev/null 2>&1 || setsid /usr/lib/cc-os/cc-os-install-dropbox >/dev/null 2>&1 &
fi
/usr/lib/cc-os/cc-os-start-dropbox
setsid /usr/lib/cc-os/cc-os-link-memory >/dev/null 2>&1 9>&- &
exit 0
