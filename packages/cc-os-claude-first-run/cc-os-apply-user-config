#!/bin/bash
# Idempotently adds CC/OS's personal Hyprland overrides to the user's config.
# Appended at login rather than shipped in /etc/skel, because Omarchy's own
# package already owns those skel files.
changed=0
hypr="$HOME/.config/hypr"
mkdir -p "$hypr"
if ! grep -q "cc-os-claude-toggle" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: Super+S summons / hides Claude Desktop full screen.
o.rebind("SUPER + S", "Claude", "/usr/lib/cc-os/cc-os-claude-toggle")
LUA
  changed=1
fi
if ! grep -q "cc-os-app-toggle" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS personal bindings. Super+B / Super+T show and hide the browser and a
-- dedicated terminal instead of opening a new window every time.
hl.unbind("SUPER + SHIFT + B")
o.rebind("SUPER + B", "Browser", "/usr/lib/cc-os/cc-os-app-toggle browser microsoft-edge omarchy-launch-browser")
o.rebind("SUPER + T", "Terminal", "/usr/lib/cc-os/cc-os-app-toggle terminal cc-os.terminal xdg-terminal-exec --app-id=cc-os.terminal")
LUA
  changed=1
fi
if ! grep -q "CC/OS: Super+L locks" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: Super+L locks the screen (moved from Super+Ctrl+L).
hl.unbind("SUPER + CTRL + L")
o.rebind("SUPER + L", "Lock system", "omarchy-system-lock")
LUA
  changed=1
fi
if ! grep -q "cc-os-overview-toggle" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: Super+O tiles every window (Claude included); press again to widen the
-- focused one.
o.rebind("SUPER + O", "Tile all / widen focused", "/usr/lib/cc-os/cc-os-overview-toggle")
LUA
  changed=1
fi
if ! grep -q "CC/OS: Super+E" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: Super+E opens the file manager (same as Super+Shift+F).
o.bind("SUPER + E", "File manager", { omarchy = "nautilus" })
LUA
  changed=1
fi
if ! grep -q "CC/OS: no Super+Shift+F" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: no Super+Shift+F; the file manager is on Super+E.
hl.unbind("SUPER + SHIFT + F")
LUA
  changed=1
fi
if ! grep -q "CC/OS: simple resize" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: simple resize. Super+= grows the focused window as a whole, Super+- shrinks
-- it; Alt = a little, Ctrl = a lot. The per-edge Shift variants are removed.
for _, keys in ipairs({ "SUPER + SHIFT", "SUPER + SHIFT + ALT", "SUPER + CTRL + SHIFT" }) do
  hl.unbind(keys .. " + code:20")
  hl.unbind(keys .. " + code:21")
end
for mod, step in pairs({ ["SUPER"] = 100, ["SUPER + ALT"] = 25, ["SUPER + CTRL"] = 300 }) do
  o.rebind(mod .. " + code:21", "Grow window", hl.dsp.window.resize({ x = step, y = step, relative = true }))
  o.rebind(mod .. " + code:20", "Shrink window", hl.dsp.window.resize({ x = -step, y = -step, relative = true }))
end
LUA
  changed=1
fi
if ! grep -q "CC/OS: no Super+Return" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: no Super+Return / Super+Shift+Return; terminal and browser are on Super+T / Super+B.
hl.unbind("SUPER + RETURN")
hl.unbind("SUPER + SHIFT + RETURN")
LUA
  changed=1
fi
if ! grep -q "CC/OS: Super+F full screen" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: Super+F full screen; no Super+Alt+F (Super+O widens the focused window).
o.rebind("SUPER + F", "Full screen", hl.dsp.window.fullscreen({ mode = "fullscreen" }))
hl.unbind("SUPER + ALT + F")
LUA
  changed=1
fi
if ! grep -q "CC/OS: no floating keys" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: no floating keys; Super+O tiles everything instead.
hl.unbind("SUPER + ALT + T")
hl.unbind("SUPER + ALT + O")
LUA
  changed=1
fi
if ! grep -q "CC/OS: no app shortcuts" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: no app shortcuts for Omarchy's preinstalled apps and web apps; ask Claude
-- instead.
for _, keys in ipairs({
  "SUPER + SHIFT + A", "SUPER + SHIFT + ALT + A", "SUPER + SHIFT + CTRL + A",
  "SUPER + SHIFT + E", "SUPER + SHIFT + ALT + E", "SUPER + SHIFT + C",
  "SUPER + SHIFT + G", "SUPER + SHIFT + ALT + G", "SUPER + SHIFT + CTRL + G",
  "SUPER + SHIFT + M", "SUPER + SHIFT + ALT + M", "SUPER + SHIFT + D",
  "SUPER + SHIFT + N", "SUPER + SHIFT + O", "SUPER + SHIFT + W",
  "SUPER + SHIFT + P", "SUPER + SHIFT + Y", "SUPER + SHIFT + X", "SUPER + SHIFT + ALT + X",
  "SUPER + SHIFT + ALT + S", "SUPER + SHIFT + SLASH",
  "SUPER + SHIFT + ALT + B", "SUPER + ALT + SHIFT + F",
  "SUPER + ALT + RETURN", "SUPER + CTRL + RETURN", "SUPER + ALT + K", "SUPER + CTRL + K",
}) do
  hl.unbind(keys)
end
LUA
  changed=1
fi
if ! grep -q "CC/OS: no widget shortcuts" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: no widget shortcuts (notifications, reminders, clock, calendar, weather,
-- battery, activity, calculator); ask Claude instead. The calculator hardware key stays.
for _, keys in ipairs({
  "SUPER + comma", "SUPER + SHIFT + comma", "SUPER + ALT + comma", "SUPER + SHIFT + ALT + comma",
  "SUPER + CTRL + comma",
  "SUPER + CTRL + R", "SUPER + CTRL + ALT + R", "SUPER + SHIFT + CTRL + R",
  "SUPER + CTRL + ALT + T", "SUPER + CTRL + ALT + E", "SUPER + CTRL + ALT + D",
  "SUPER + CTRL + ALT + W", "SUPER + CTRL + ALT + B",
  "SUPER + CTRL + Q", "SUPER + CTRL + T",
  "SUPER + ALT + SHIFT + F",
}) do
  hl.unbind(keys)
end
LUA
  changed=1
fi
if ! grep -q "CC/OS: Super+Tab switches windows" "$hypr/bindings.lua" 2>/dev/null; then
  cat >>"$hypr/bindings.lua" <<'LUA'

-- CC/OS: Super+Tab switches windows like Alt+Tab (Super+Shift+Tab goes back),
-- instead of switching workspaces.
o.rebind("SUPER + TAB", "Focus on next window", hl.dsp.window.cycle_next())
o.bind("SUPER + TAB", "Reveal active window on top", hl.dsp.window.bring_to_top())
o.rebind("SUPER + SHIFT + TAB", "Focus on previous window", hl.dsp.window.cycle_next({ next = false }))
o.bind("SUPER + SHIFT + TAB", "Reveal active window on top", hl.dsp.window.bring_to_top())
LUA
  changed=1
fi
if ! grep -q "CC/OS: natural" "$hypr/input.lua" 2>/dev/null; then
  cat >>"$hypr/input.lua" <<'LUA'

-- CC/OS: natural (inverse) touchpad scrolling.
hl.config({ input = { touchpad = { natural_scroll = true } } })
LUA
  changed=1
fi
(( changed )) && hyprctl reload >/dev/null 2>&1
exit 0
