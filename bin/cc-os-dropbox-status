#!/usr/bin/env python3
# Prints the Dropbox daemon's current status line ("Up to date", "Syncing...",
# "Starting...", ...), or nothing if the daemon isn't answering. The package
# ships only the daemon -- /usr/bin/dropbox IS the daemon, so "dropbox status"
# would start a second one -- so this speaks to its local command socket, the
# same protocol the official command-line client uses.
import os, socket
try:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(5)
    s.connect(os.path.expanduser("~/.dropbox/command_socket"))
    s.sendall(b"get_dropbox_status\ndone\n")
    for line in s.recv(4096).decode().splitlines():
        if line.startswith("status\t"):
            print(line.split("\t", 1)[1])
except Exception:
    pass
