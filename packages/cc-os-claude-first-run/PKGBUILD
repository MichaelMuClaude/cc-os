# Maintainer: CC/OS
pkgname=cc-os-claude-first-run
pkgver=1.4.11
pkgrel=1
pkgdesc="CC/OS: Claude Desktop as the main interface -- no AI chooser, Super+S/B/T show-hide toggles, Super+O tile-all/widen, Dropbox-synced memory, natural touchpad scrolling"
arch=('any')
license=('MIT')
depends=('networkmanager' 'sudo' 'jq' 'util-linux' 'xdg-utils')
source=('default-agent' 'cc-os-claude-toggle' 'cc-os-app-toggle' 'cc-os-overview-toggle' 'cc-os-apply-user-config' 'cc-os-install-apps'
        'cc-os-install-dropbox' 'cc-os-dropbox-status' 'cc-os-start-dropbox' 'cc-os-link-memory' 'cc-os-session-start' 'cc-os-session.desktop')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 default-agent "$pkgdir/etc/skel/.config/omarchy/defaults/agent"
  for f in cc-os-claude-toggle cc-os-app-toggle cc-os-overview-toggle cc-os-apply-user-config cc-os-install-apps cc-os-install-dropbox cc-os-dropbox-status cc-os-start-dropbox cc-os-link-memory cc-os-session-start; do
    install -Dm755 "$f" "$pkgdir/usr/lib/cc-os/$f"
  done
  install -Dm644 cc-os-session.desktop "$pkgdir/etc/xdg/autostart/cc-os-session.desktop"
}
