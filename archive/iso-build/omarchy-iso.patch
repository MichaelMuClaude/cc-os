diff --git a/configs/airootfs/usr/local/bin/cc-os-prepare-autoinstall b/configs/airootfs/usr/local/bin/cc-os-prepare-autoinstall
new file mode 100755
index 0000000..a07919b
--- /dev/null
+++ b/configs/airootfs/usr/local/bin/cc-os-prepare-autoinstall
@@ -0,0 +1,85 @@
+#!/bin/bash
+#
+# CC/OS: renders the baked-in cidata template (install/usr/local/share/cc-os/
+# cidata/user_configuration.json.template) into a real user_configuration.json
+# by substituting the real target disk and partition geometry, then writes it
+# plus a defer-provisioning marker to /root so the orchestrator picks them up
+# exactly as it would a real cidata drive's output.
+#
+# Deliberately conservative: refuses to guess when there is more than one
+# plausible target disk, or none at all, rather than risk wiping the wrong
+# one. A refusal exits non-zero so the caller (omarchy-cidata-load) falls
+# back to its normal external-drive search and, failing that, the
+# interactive wizard — a human picks the disk by hand in that case.
+#
+# The optional argument prefixes every path the script touches; tests use it
+# to run against a sandbox instead of the live system.
+
+set -uo pipefail
+
+root=${1:-}
+template=$root/usr/local/share/cc-os/cidata/user_configuration.json.template
+dest=$root/root
+
+[[ -f $template ]] || exit 1
+
+udevadm settle 2>/dev/null || true
+
+# Identify the live boot medium's underlying disk so it's never picked as an
+# install target. /run/archiso/bootmnt is where the live squashfs lives.
+boot_source=$(findmnt -n -o SOURCE "$root/run/archiso/bootmnt" 2>/dev/null) || boot_source=""
+boot_disk=""
+if [[ -n $boot_source ]]; then
+  boot_disk=$(lsblk -no PKNAME "$boot_source" 2>/dev/null | head -1)
+fi
+
+# Candidate disks: type=disk, not removable, not the live medium's own disk.
+# lsblk's plain -ndo output is whitespace-separated (not tab-separated), so
+# this relies on read's default IFS (space/tab/newline) rather than pinning
+# IFS to a literal tab, which would leave every field after the first empty.
+candidates=()
+while read -r name rm type; do
+  [[ $type == disk ]] || continue
+  [[ $rm == "0" ]] || continue
+  [[ -n $boot_disk && $name == "$boot_disk" ]] && continue
+  candidates+=("$name")
+done < <(lsblk -ndo NAME,RM,TYPE)
+
+(( ${#candidates[@]} == 1 )) || exit 1
+
+disk_name=${candidates[0]}
+disk_path="/dev/$disk_name"
+disk_bytes=$(lsblk -bndo SIZE "$disk_path" 2>/dev/null)
+[[ $disk_bytes =~ ^[0-9]+$ ]] || exit 1
+
+sector_size=$(lsblk -ndo LOG-SEC "$disk_path" 2>/dev/null | tr -d ' ')
+[[ $sector_size =~ ^[0-9]+$ ]] || exit 1
+
+mib=$((1024 * 1024))
+gib=$((1024 * 1024 * 1024))
+boot_start=$mib
+boot_size=$((2 * gib))
+main_start=$((boot_start + boot_size))
+# archinstall rejects any partition whose length isn't a whole MiB, and real
+# disks are almost never a whole number of MiB, so round down — this also
+# keeps the end clear of the 1MiB backup GPT reserve archinstall checks for.
+main_size=$(( (disk_bytes - main_start - mib) / mib * mib ))
+
+# A disk smaller than ~3GiB (boot + reserve) cannot hold this layout; refuse
+# rather than write a config that will fail partitioning.
+(( main_size > 0 )) || exit 1
+
+rendered=$(sed \
+  -e "s|__CC_OS_TARGET_DISK__|$disk_path|g" \
+  -e "s|__CC_OS_BOOT_START__|$boot_start|g" \
+  -e "s|__CC_OS_BOOT_SIZE__|$boot_size|g" \
+  -e "s|__CC_OS_MAIN_START__|$main_start|g" \
+  -e "s|__CC_OS_MAIN_SIZE__|$main_size|g" \
+  -e "s|__CC_OS_SECTOR_SIZE__|$sector_size|g" \
+  "$template")
+
+mkdir -p "$dest"
+printf '%s\n' "$rendered" >"$dest/user_configuration.json" || exit 1
+: >"$dest/defer-provisioning"
+
+exit 0
diff --git a/configs/airootfs/usr/local/bin/omarchy-cidata-load b/configs/airootfs/usr/local/bin/omarchy-cidata-load
index 6578849..c988d84 100755
--- a/configs/airootfs/usr/local/bin/omarchy-cidata-load
+++ b/configs/airootfs/usr/local/bin/omarchy-cidata-load
@@ -24,6 +24,16 @@ by_label=$root/dev/disk/by-label
 dest=$root/root
 mnt=$root/run/cidata
 
+# CC/OS: a baked-in autoinstall template takes priority over an external
+# cidata drive when present, so this image's own copy of the config renders
+# itself against the real target disk without needing a second USB stick at
+# all. cc-os-prepare-autoinstall refuses to run (exits non-zero) when it
+# can't identify exactly one safe target disk, in which case this falls
+# through to the ordinary external-drive search below exactly as before.
+if /usr/local/bin/cc-os-prepare-autoinstall "$root"; then
+  exit 0
+fi
+
 # The by-label symlinks come from udev, and on a fast boot this can run before
 # device enumeration has finished. Wait for the queue to drain instead of
 # racing it and silently dropping a headless install into the wizard.
